{
	"name": "consumer-price-tracker",
	"description": "Consumer price analysis tool for Bulgarian market.",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"author": "Miroslav Rusev <miroslav.rusev@jakala.com>",
	"license": "MIT",
	"resolutions": {
		"yaml": "^2.4.2",
		"picomatch": "^4.0.0"
	},
	"keywords": [
		"price-monitoring",
		"market-analysis",
		"data-visualization",
		"dashboard",
		"economics",
		"food-prices",
		"fuel-prices",
		"utility-costs",
		"market-trends",
		"price-analytics"
	],
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint ."
	},
	"dependencies": {
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/kit": "^2.70.0",
		"@vercel/analytics": "^1.5.0",
		"autoprefixer": "^10.4.21",
		"chart.js": "^4.5.0",
		"postcss": "^8.5.6",
		"svelte": "^5.56.0",
		"svelte5-chartjs": "^1.0.0",
		"tailwindcss": "^3.4.17"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.0",
		"@eslint/js": "^10.0.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tailwindcss/forms": "^0.5.11",
		"eslint": "^10.8.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^16.0.0",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte-check": "^4.7.6",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.67.0",
		"vite": "^8.2.1"
	}
}
