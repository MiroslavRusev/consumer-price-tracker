{
	"$schema": "https://json.schemastore.org/claude-code-settings.json",
	"permissions": {
		"allow": [
			"Bash(yarn run check)",
			"Bash(yarn run check:*)",
			"Bash(yarn lint)",
			"Bash(yarn run lint)",
			"Bash(yarn format)",
			"Bash(yarn build)",
			"Bash(yarn run build)",
			"Bash(yarn check:data-sources)",
			"Bash(npx svelte-kit sync)",
			"Bash(npx svelte-check:*)",
			"Bash(npx eslint:*)",
			"Bash(npx prettier --check:*)",
			"Bash(npm view:*)",
			"Bash(git status:*)",
			"Bash(git diff:*)",
			"Bash(git log:*)",
			"Bash(curl -s http://localhost:5173/:*)",
			"Bash(curl -s localhost:5173/:*)"
		],
		"deny": ["Read(./.env)", "Read(./.env.local)", "Read(./.env.production)", "Read(./.env.development)"]
	}
}
